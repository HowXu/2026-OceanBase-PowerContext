{
  "name": "task-progress-tracker",
  "version": "1.1.0",
  "type": "module",
  "description": "Task progress tracker using PowerContext for cross-session task management",
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/build.mjs",
    "setup:scope": "node --env-file-if-exists=.env scripts/init-scope.mjs",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration.test.js"
  },
  "engines": { "node": ">=22.9.0" },
  "dependencies": {
    "express": "^4.18.2"
  }
}
