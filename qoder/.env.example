# Local development; configure the same values as Qoder Function Secrets in production.
POWERCONTEXT_URL=http://127.0.0.1:8000
# Obtain the real opaque ID with npm run setup:scope.
POWERCONTEXT_SCOPE_ID=
POWERCONTEXT_TOKEN=
# Alternative for existing deployments; takes precedence over TOKEN.
POWERCONTEXT_AUTH_HEADER=
HOST=127.0.0.1
PORT=3000
