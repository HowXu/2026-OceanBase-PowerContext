# Generate these locally with python scripts/configure.py. Never commit .env.
GATEWAY_TOKEN=replace-with-at-least-32-random-characters
POWERCONTEXT_URL=http://powercontext:8000
POWERCONTEXT_TOKEN=
DIFY_API_URL=http://dify-api:5001/v1
DIFY_API_KEY=
# Optional OpenAI-compatible model API. Empty key enables labelled rule narration.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
# Local-only Dify deployment secrets, generated by configure.py.
DIFY_SECRET_KEY=replace-with-random-secret
DB_PASSWORD=replace-with-random-password
REDIS_PASSWORD=replace-with-random-password
SANDBOX_API_KEY=replace-with-random-secret
